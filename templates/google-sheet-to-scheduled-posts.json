      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "4f66322f-ae65-5cb1-be50-e44e10500417",
              "leftValue": "={{ $json.Text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "10b513a8-caaa-54c5-836d-8981eccf8518",
              "leftValue": "={{ DateTime.fromFormat(String($json['Publish At'] ?? ''), 'yyyy-MM-dd HH:mm', { zone: $('Configure').first().json.timezone }).isValid && DateTime.fromFormat(String($json['Publish At'] ?? ''), 'yyyy-MM-dd HH:mm', { zone: $('Configure').first().json.timezone }) > $now }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7ddddd9e-d9ae-5a0a-805d-f59dbd000ca5",
      "name": "Text and a future time",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        460,
        40
      ]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "create",
        "workspaceId": "={{ $('Configure').first().json.workspaceId }}",
        "accounts": "={{ $('Configure').first().json.accountIds }}",
        "text": "={{ $json.Text }}",
        "media": {
          "item": [
            {
              "type": "image",
              "name": "={{ ($json['Image URL'] || '').split('/').pop() || 'image.jpg' }}",
              "url": "={{ $json['Image URL'] }}"
            }
          ]
        },
        "additionalFields": {
          "status": "scheduled",
          "schedule_at": "={{ DateTime.fromFormat(String($json['Publish At'] ?? ''), 'yyyy-MM-dd HH:mm', { zone: $('Configure').first().json.timezone }).toUTC().toISO() }}"
        }
      },
      "id": "a63a2f88-0836-56c8-992c-c61a51ad9403",
      "name": "Schedule in FoPost",
