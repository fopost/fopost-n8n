        "message": "={{ $('Write a draft per network').first().json.release }} is out. {{ $json.postIds.length }} drafts are waiting in FoPost:\n\n{{ $('Write a draft per network').all().map(d => '*' + d.json.network + '*\\n' + d.json.text).join('\\n\\n') }}\n\nApprove to publish all of them now.",
        "approvalOptions": {
