              "limitType": "afterTimeInterval",
              "resumeAmount": 7,
              "resumeUnit": "days"
            }
          }
        }
      },
      "id": "a9cebf17-1edb-5582-9bb2-3e939c0a96eb",
      "name": "Ask for approval in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
