      "id": "d4338461-19b6-554f-bd83-ae0bb96db861",
      "name": "Configure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const { release, repository } = $('GitHub release published').first().json.body;\nconst cfg = $('Configure').first().json;\nconst title = release.name || release.tag_name;\nconst url = release.html_url;\n\n// Release notes as bullet lines: headings dropped, list markers stripped.\nconst notes = (release.body || '')\n  .split('\\n')\n  .filter((line) => !line.trim().startsWith('#'))\n  .map((line) => line.replace(/^[*\\-\\s]+/, '').trim())\n  .filter((line) => line.length > 0);\n\n// Add notes until the next one would push the post past the network limit.\nfunction fit(intro, limit) {\n  let text = intro;\n  for (const note of notes) {\n    const next = `${text}\\n• ${note}`;\n    if (`${next}\\n\\n${url}`.length > limit) break;\n    text = next;\n  }\n  return `${text}\\n\\n${url}`;\n}\n\nconst drafts = [\n  { network: 'X', accountId: cfg.xAccountId, text: fit(`${title} is out.`, 280) },\n  { network: 'Bluesky', accountId: cfg.blueskyAccountId, text: fit(`${title} is out.`, 300) },\n  {\n    network: 'LinkedIn',\n    accountId: cfg.linkedinAccountId,\n    text: fit(`We just shipped ${title} of ${repository.full_name}. What is new:`, 3000),\n  },\n];\n\n// Skip any network whose account ID was left empty or unchanged in Configure.\nreturn drafts\n  .filter((d) => d.accountId && !d.accountId.startsWith('REPLACE_'))\n  .map((d) => ({ json: { ...d, workspaceId: cfg.workspaceId, release: title } }));\n"
      },
      "id": "ebc07200-dd89-5a4f-a45b-cfe3cbce2fa6",
      "name": "Write a draft per network",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
