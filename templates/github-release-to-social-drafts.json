      "name": "Only published releases",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        220,
        40
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "6b27d52e-136b-5853-8d13-216956880e55",
              "name": "workspaceId",
              "value": "REPLACE_WITH_FOPOST_WORKSPACE_ID",
