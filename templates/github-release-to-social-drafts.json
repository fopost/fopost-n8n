            },
            {
              "id": "e4c2ae0f-0c33-5d07-ae42-9c1c77616852",
              "name": "xAccountId",
              "value": "REPLACE_WITH_X_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "c66a8b0b-93f8-5b11-a006-354724e8ce4b",
              "name": "blueskyAccountId",
              "value": "REPLACE_WITH_BLUESKY_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "68a6358a-78c8-5343-91fb-a45b85c5b6d3",
              "name": "linkedinAccountId",
              "value": "REPLACE_WITH_LINKEDIN_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "038261ec-8e8b-56f1-9d3c-b37644825d34",
              "name": "slackChannel",
              "value": "#releases",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
