{
  "name": "n8n-nodes-fopost",
  "version": "0.1.0",
  "description": "n8n community node for FoPost. Schedule and publish social media posts, read analytics, and trigger workflows on publishing events.",
  "license": "MIT",
  "author": {
    "name": "Porter Bridge, LLC",
    "url": "https://fopost.com"
  },
  "homepage": "https://fopost.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fopost/fopost-n8n.git"
  },
  "bugs": {
    "url": "https://github.com/fopost/fopost-n8n/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "fopost",
    "social-media",
    "publishing",
    "scheduling",
    "analytics"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "format": "prettier credentials nodes test --write",
    "format:check": "prettier credentials nodes test --check",
    "test": "jest",
    "prepublishOnly": "node -e \"if(!process.env.GITHUB_ACTIONS){console.error('Publish from the release workflow so npm records provenance.');process.exit(1)}\" && npm run lint && npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FoPostApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FoPost/FoPost.node.js",
      "dist/nodes/FoPostTrigger/FoPostTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "nock": "^13.5.6",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
